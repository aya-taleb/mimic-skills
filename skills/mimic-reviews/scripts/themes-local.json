{
 "_about": "Themes for local businesses, services and physical products, used by reviews.py --themes themes-local.json. Same format as themes.json. Patterns are Python regular expressions matched case-insensitively. Add the category's own words (for food: cold, soggy, portion; for cleaning: missed spots, late).",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
  "\\bwish (there was|there were|it had|it was|the|they|we could|i could)\\b",
  "\\bis there (any|a|an) \\w+"
 ],
 "themes": [
  {
   "id": "price",
   "label": "Price and value",
